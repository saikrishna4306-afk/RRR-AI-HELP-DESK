# ===== Provider selection (choose implementation by env, never by code edits) =====
# LLM used to write answers: gnani | gemini | mock
LLM_PROVIDER=mock
# LLM used if the primary fails or is not configured
LLM_FALLBACK=gemini
# Speech-to-text: gnani | gemini | mock
STT_PROVIDER=mock
# STT fallback
STT_FALLBACK=gemini
# Text-to-speech: gnani | edge | gemini(not implemented, falls through) | mock
TTS_PROVIDER=gnani
# TTS fallback if Gnani is not configured or unavailable
TTS_FALLBACK=edge
# Photo/video understanding: gemini | mock
VISION_PROVIDER=gemini
# Embeddings for search: gemini | hash (offline, free)
EMBED_PROVIDER=hash

# ===== Gnani (docs.gnani.ai) =====
# Your Gnani API key (sent as X-API-Key-ID header)
GNANI_API_KEY=
# Gnani API base URL
GNANI_BASE_URL=https://api.vachana.ai
# STT model: prisma-v3.0 (supports indic-auto) or prisma-v2.5
GNANI_STT_MODEL=prisma-v3.0
# TTS model; Shivani is a Timbre v3.0 multilingual voice
GNANI_TTS_MODEL=timbre-v3.0
# Voice catalog: https://docs.gnani.ai/api/TTS/available-voices
GNANI_TTS_VOICE_TE=Shivani
GNANI_TTS_VOICE_HI=Shivani
GNANI_TTS_VOICE_EN=Shivani
# Gnani LLM OpenAI-compatible base URL (ends before /chat/completions), from your internship dashboard/docs
GNANI_LLM_BASE_URL=
# Gnani LLM key (empty = reuse GNANI_API_KEY)
GNANI_LLM_API_KEY=
# Gnani LLM model name
GNANI_LLM_MODEL=
# Credit cost per second of STT audio (0 = unknown; ledger still counts units)
GNANI_STT_CREDITS_PER_SEC=0
# Credit cost per 1000 TTS characters (0 = unknown)
GNANI_TTS_CREDITS_PER_1K_CHARS=0
# Credit cost per 1000 LLM tokens (0 = unknown)
GNANI_LLM_CREDITS_PER_1K_TOKENS=0
# Stop using Gnani (fall back to free providers) after this many estimated credits
GNANI_CREDIT_BUDGET=5000

# ===== Gemini (https://aistudio.google.com/apikey) =====
# Gemini API key
GEMINI_API_KEY=
# Model names are left blank on purpose (free-tier names change). Run: python scripts/list_gemini_models.py
# Text model for answers
GEMINI_LLM_MODEL=
# Multimodal model for photos/videos
GEMINI_VISION_MODEL=
# Embedding model (only used when EMBED_PROVIDER=gemini)
GEMINI_EMBED_MODEL=
# Audio-capable model for speech-to-text
GEMINI_STT_MODEL=

# ===== edge-tts voices (free) =====
# Telugu voice
EDGE_VOICE_TE=te-IN-ShrutiNeural
# Hindi voice
EDGE_VOICE_HI=hi-IN-SwaraNeural
# English voice
EDGE_VOICE_EN=en-IN-NeerjaNeural

# ===== App =====
# Password for the /admin page (change this!)
ADMIN_TOKEN=change-me
# Database (default SQLite file); e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///data/app.db
# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# Min cosine similarity for a confident match with the offline hash embedder
CONFIDENCE_THRESHOLD_HASH=0.32
# Min cosine similarity for a confident match with Gemini embeddings
CONFIDENCE_THRESHOLD_GEMINI=0.55
# Min vision confidence to trust a photo/video diagnosis
VISION_MIN_CONFIDENCE=0.6
# Timeout per provider call in seconds
PROVIDER_TIMEOUT_S=25
# Max /api/ask requests per IP per minute
RATE_LIMIT_PER_MIN=30

# ===== Upload limits =====
# Max audio size in MB
MAX_AUDIO_MB=2
# Max audio length in seconds
MAX_AUDIO_SECONDS=30
# Max photo size in MB
MAX_IMAGE_MB=5
# Max video size in MB
MAX_VIDEO_MB=15
# Max video length in seconds
MAX_VIDEO_SECONDS=20
# Max typed question length
MAX_TEXT_CHARS=1000
